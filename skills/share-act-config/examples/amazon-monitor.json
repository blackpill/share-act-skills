{
  "envelope_version": 1,
  "rule": {
    "id": "amazon-monitor",
    "version": 1,
    "position": 0,
    "name": "amazon monitor",
    "groups": [
      [
        {
          "type": "shareact.core.model.Condition.Type",
          "value": "LINK"
        },
        {
          "type": "shareact.core.model.Condition.Domain",
          "value": "amazon.com",
          "includeSubdomains": true
        }
      ]
    ],
    "templateRef": {
      "id": "amazon-monitor-template",
      "version": 1
    },
    "action": {
      "type": "shareact.core.model.Action.Webhook",
      "connectionId": "selected-bot-fixture"
    },
    "enabled": true,
    "executionMode": "CONFIRM",
    "grant": null
  },
  "template": {
    "id": "amazon-monitor-template",
    "version": 1,
    "instruction": "Inspect the product at {{url}}. Check that authorized recurring monitoring and notification tools exist. Use monitoring_id=fixture-monitor and notification_target=fixture-bot-conversation only after authorization. Confirm frequency, duration, region, currency and price/restock/coupon criteria. Do not purchase. These settings are fixtures and do not enable a real monitor.",
    "outputPreferences": {
      "language": "en",
      "format": "markdown"
    }
  },
  "test_input": {
    "type": "LINK",
    "text": "Product access test",
    "subject": "",
    "url": "https://www.amazon.com/dp/B000000000",
    "mime_type": "text/plain",
    "file_name": null
  }
}
